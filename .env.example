# Required
OPENAI_API_KEY=sk-...
DATABASE_URL=postgres://...

# Optional — model routing (quality-first defaults shown)
OPENAI_PLANNER_MODEL=gpt-5.6-terra
OPENAI_COMPOSER_MODEL=gpt-5.6-sol
OPENAI_ANALYZER_MODEL=gpt-5.6-sol
OPENAI_REVISER_MODEL=gpt-5.6-sol
OPENAI_REQUEST_TIMEOUT_MS=285000

# Optional — ElevenLabs (for audio playback)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
BLOB_READ_WRITE_TOKEN=
